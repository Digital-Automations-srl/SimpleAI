<html xmlns='http://www.w3.org/1999/xhtml'>
  <head>
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Segnalazione Simple AI</title>
  </head>
  <body
    style='margin: 0; padding: 24px; background-color: #f4f4f5; font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: #18181b;'
  >
    <table
      role='presentation'
      cellpadding='0'
      cellspacing='0'
      style='max-width: 640px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; border: 1px solid #e4e4e7;'
    >
      <tr>
        <td style='padding: 24px 24px 8px 24px;'>
          <h1 style='margin: 0; font-size: 18px; font-weight: 600;'>
            Nuova segnalazione di miglioramento
          </h1>
        </td>
      </tr>
      <tr>
        <td style='padding: 8px 24px;'>
          <table role='presentation' cellpadding='0' cellspacing='0' style='width: 100%; font-size: 14px;'>
            <tr>
              <td style='padding: 6px 0; color: #71717a; width: 140px;'>Area funzionale</td>
              <td style='padding: 6px 0; font-weight: 600;'>{{area}}</td>
            </tr>
            <tr>
              <td style='padding: 6px 0; color: #71717a;'>Priorità</td>
              <td style='padding: 6px 0; font-weight: 600;'>{{priority}}</td>
            </tr>
            <tr>
              <td style='padding: 6px 0; color: #71717a;'>Segnalata da</td>
              <td style='padding: 6px 0;'>{{reporterName}}
                {{#if reporterEmail}}&lt;{{reporterEmail}}&gt;{{/if}}</td>
            </tr>
            {{#if appVersion}}
              <tr>
                <td style='padding: 6px 0; color: #71717a;'>Versione</td>
                <td style='padding: 6px 0;'>{{appVersion}}</td>
              </tr>
            {{/if}}
          </table>
        </td>
      </tr>
      <tr>
        <td style='padding: 16px 24px 24px 24px;'>
          <div style='color: #71717a; font-size: 14px; margin-bottom: 8px;'>Descrizione</div>
          <div
            style='white-space: pre-wrap; font-size: 14px; line-height: 1.6; background-color: #fafafa; border: 1px solid #e4e4e7; border-radius: 8px; padding: 12px;'
          >{{description}}</div>
        </td>
      </tr>
      <tr>
        <td
          style='padding: 16px 24px; border-top: 1px solid #e4e4e7; color: #a1a1aa; font-size: 12px;'
        >
          Simple AI &middot; Digital Automations &middot; {{year}}
        </td>
      </tr>
    </table>
  </body>
</html>
